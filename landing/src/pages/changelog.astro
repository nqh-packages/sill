---
import Layout from "../layouts/Layout.astro";

const testflightUrl = "https://testflight.apple.com/join/K8FpR5TR";
const forkRepoUrl = "https://github.com/nqh-packages/sill";
const upstreamRepoUrl = "https://github.com/Saffsanity/sill";
const originalSiteUrl = "https://getsill.app";

interface Release {
  version: string;
  build: string;
  date: string;
  tag?: string;
  summary: string;
  changes: string[];
}

const releases: Release[] = [
  {
    version: "0.6.3",
    build: "Build 6",
    date: "Nov 22, 2026",
    tag: "Latest",
    summary: "Lint gates for tactile workspace primitives, ClipboardChip cleanup, and site changelog.",
    changes: [
      "Added automated semantic lint rules (.jev-lint) guarding TactileTrackpadWell SSOT, the minimal ClipboardChip Paste pill, and Safari-safe media on sill.uxheavy.com.",
      "Cleaned up ClipboardChip SwiftUI dismiss button syntax and verified all 66 tactile workspace state checks.",
      "Added this /changelog page to sill.uxheavy.com with TestFlight build history.",
    ],
  },
  {
    version: "0.6.3",
    build: "Build 5",
    date: "Nov 22, 2026",
    summary: "Minimal Liquid Glass Paste pill and unified Natural Trackpad.",
    changes: [
      "Simplified ClipboardChip to a top-pinned minimal Liquid Glass Paste pill with a circular dismiss button.",
      "Unified iPhone Natural Trackpad with TactileTrackpadWell (SSOT) so letterboxed apps share the same tactile trackpad surface and gesture behavior as the Control Deck.",
      "Unified the Control Center Paste tile with DeckTile SSOT for consistent height, bevel, and press response.",
      "Fixed iOS Safari WebKit crash on sill.uxheavy.com by removing heavy CSS drop-shadow filters and added LCP preload, explicit media dimensions, reduced-motion support, and a hero video pause control.",
    ],
  },
  {
    version: "0.6.3",
    build: "Build 4",
    date: "Nov 21, 2026",
    summary: "PencilKit-style 4-edge floating chrome, full-screen iPhone default, and Liquid Glass icon.",
    changes: [
      "Redesigned iPad and iPhone floating chrome as a PencilKit-style 4-edge dock that collapses into a 48pt 4-corner orb.",
      "Made full-screen Mac apps the default on iPhone, shifting letterboxed windows upward so the space beneath works naturally as a trackpad.",
      "Consolidated tactile controls into a single-source-of-truth design system (TactileStyle) and unified keyboard and trackpad bars into TactileCommandBar.",
      "Replaced scrolling arrow keys with a tactile arrow joystick in the floating Liquid Glass keyboard bar, and refit the Mac viewport cleanly once the keyboard or Control Deck settles.",
      "Added the new Liquid Glass Sill.icon (light and dark), Unified Switcher for Desktop / open windows / installed apps, and promoted Full Screen to a Control Center tile.",
    ],
  },
];
---
<Layout
  title="Changelog — Sill Tactile"
  description="Release history and TestFlight build notes for Sill Tactile, an open-source Liquid Glass fork of Sill for iOS and iPadOS."
  canonicalPath="/changelog/"
>
  <header>
    <div class="wrap nav">
      <a class="brand" href="/">
        <img src="/icon.png" alt="Sill Tactile icon" width="28" height="28" />
        <span>Sill Tactile</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/#ipad">iPad</a>
        <a href="/#iphone">iPhone</a>
        <a href="/changelog/" aria-current="page">Changelog</a>
        <a href={forkRepoUrl}>GitHub</a>
        <a class="nav-cta" href={testflightUrl}>TestFlight</a>
      </nav>
    </div>
  </header>

  <main class="wrap changelog">
    <div class="changelog-head">
      <span class="eyebrow">TestFlight Releases</span>
      <h1>Changelog</h1>
      <p class="lede">
        Every TestFlight build of <strong>Sill Tactile</strong> (<code>com.uxheavy.sill</code>), built on
        <a href={upstreamRepoUrl}>Noah Saffer’s Sill</a>.
      </p>
    </div>

    <ol class="timeline">
      {releases.map((rel) => (
        <li class="release">
          <div class="release-meta">
            <div class="release-version">
              <span class="ver">{rel.version}</span>
              <span class="build">{rel.build}</span>
              {rel.tag && <span class="badge">{rel.tag}</span>}
            </div>
            <time class="release-date">{rel.date}</time>
          </div>
          <p class="release-summary">{rel.summary}</p>
          <ul class="release-list">
            {rel.changes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </main>

  <footer>
    <div class="wrap footer-inner">
      <span>Fork of <a href={upstreamRepoUrl}>Saffsanity/sill</a> by Noah Saffer &middot; Apache-2.0 &middot; Tested only on Huy’s iPhone 17 &amp; iPad Pro</span>
      <div class="footer-links">
        <a href={testflightUrl}>TestFlight</a>
        <a href="/changelog/">Changelog</a>
        <a href={forkRepoUrl}>Fork</a>
        <a href={originalSiteUrl}>Original Sill</a>
        <a href="/privacy/">Privacy</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--rim-soft);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 54px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .brand:hover { text-decoration: none; }
  .brand img { width: 28px; height: 28px; border-radius: 7px; }
  .nav-links { display: flex; align-items: center; gap: 18px; font-size: 14px; }
  .nav-links a { color: var(--ink-2); }
  .nav-links a:hover, .nav-links a[aria-current="page"] { color: var(--ink); text-decoration: none; }
  .nav-cta {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--blue);
    color: #fff !important;
    font-weight: 600;
    font-size: 13px;
  }
  .nav-cta:hover { background: #1e8fff; }

  .changelog {
    max-width: 760px;
    padding: 56px 22px 48px;
  }
  .changelog-head { margin-bottom: 40px; }
  .eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cyan);
    margin-bottom: 8px;
  }
  h1 {
    margin: 0 0 12px;
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .lede {
    margin: 0;
    font-size: 16px;
    color: var(--ink-2);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .release {
    background: var(--surface);
    border: 1px solid var(--rim-soft);
    border-radius: 18px;
    padding: 24px 26px;
  }
  .release-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }
  .release-version {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ver {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .build {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink-2);
    background: var(--raised);
    border: 1px solid var(--rim-soft);
    padding: 2px 9px;
    border-radius: 999px;
  }
  .badge {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #000;
    background: var(--cyan);
    padding: 2px 9px;
    border-radius: 999px;
  }
  .release-date {
    font-size: 13px;
    color: var(--ink-3);
  }
  .release-summary {
    margin: 0 0 14px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }
  .release-list {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--ink-2);
    font-size: 14.5px;
    line-height: 1.55;
  }

  footer {
    margin-top: 40px;
    border-top: 1px solid var(--rim-soft);
    padding: 26px 0 44px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .footer-links { display: flex; gap: 18px; }
  .footer-links a { color: var(--ink-2); }
</style>
