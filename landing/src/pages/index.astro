---
import Layout from "../layouts/Layout.astro";

const testflightUrl = "https://testflight.apple.com/join/K8FpR5TR";
const forkRepoUrl = "https://github.com/nqh-packages/sill";
const upstreamRepoUrl = "https://github.com/Saffsanity/sill";
const originalSiteUrl = "https://getsill.app";
---
<Layout
  title="Sill Tactile — A different take on Sill for iOS & iPadOS"
  description="A tactile, Liquid Glass take on Noah Saffer's open-source Sill for iOS & iPadOS. Tested only on my iPhone 17 & iPad Pro."
  canonicalPath="/"
  preloadImage="/media/pencilkit-poster.jpg"
>
  <div class="ambient-bg" aria-hidden="true"></div>

  <header>
    <div class="wrap nav">
      <a class="brand" href="/">
        <img src="/icon.png" alt="Sill Tactile icon" width="28" height="28" />
        <span>Sill Tactile</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="#ipad">iPad</a>
        <a href="#iphone">iPhone</a>
        <a href={forkRepoUrl}>GitHub</a>
        <a class="nav-cta" href={testflightUrl}>TestFlight</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <section class="hero">
      <div class="hero-copy">
        <div class="icon-pair enter" style="--d: 0ms">
          <img class="app-icon" src="/icon.png" alt="Sill Tactile dark Liquid Glass icon" width="68" height="68" />
          <img class="app-icon" src="/icon-light.png" alt="Sill Tactile light Liquid Glass icon" width="68" height="68" />
        </div>
        <h1 class="enter" style="--d: 70ms">Sill, reimagined<br />for touch.</h1>
        <p class="lede enter" style="--d: 140ms">
          A different take on <a href={upstreamRepoUrl}>Noah Saffer’s Sill</a> for iOS &amp; iPadOS.
          Same <a href={`${originalSiteUrl}/download.html`}>Sill for Mac</a> &amp; encrypted protocol.
        </p>
        <div class="cta-row enter" style="--d: 210ms">
          <a class="btn btn-primary" href={testflightUrl}>Join TestFlight Beta</a>
          <a class="btn btn-secondary" href={forkRepoUrl}>View on GitHub</a>
        </div>
        <p class="disclaimer enter" style="--d: 280ms">
          All credit to <a href="https://github.com/Saffsanity">Noah Saffer</a> (<a href={upstreamRepoUrl}>Saffsanity/sill</a>).<br />
          <strong>Only tested on my own iPhone 17 &amp; iPad Pro</strong> — for the official app, use <a href={originalSiteUrl}>getsill.app</a>.
        </p>
      </div>

      <div class="hero-stage enter" style="--d: 140ms">
        <div class="device-glow" aria-hidden="true"></div>
        <div class="apple-device apple-ipad-land hero-ipad">
          <div class="apple-screen apple-ipad-land-screen">
            <video
              id="hero-video"
              src="/media/pencilkit-chrome.mp4"
              poster="/media/pencilkit-poster.jpg"
              width="1194"
              height="834"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label="Live Blender 5.2.3 LTS streamed from Mac to iPad Pro in landscape with Sill Tactile PencilKit floating chrome docking across edges and corners"
            ></video>
          </div>
          <img class="apple-bezel" src="/bezels/ipad-pro-11-landscape.png" width="1050" height="748" fetchpriority="high" alt="" aria-hidden="true" draggable="false" />
        </div>
        <div class="stage-caption">
          <span>Live Mac capture (Blender 5.2) · Drag to orb · 4-edge dock · 4-corner minimize</span>
          <button type="button" class="video-toggle" id="hero-video-toggle">Pause</button>
        </div>
      </div>
    </section>

    <section class="chapter reveal" id="ipad">
      <div class="chapter-head">
        <span class="eyebrow">iPad · Landscape</span>
        <h2>Full canvas. Zero clutter.</h2>
      </div>
      <div class="grid-ipad">
        <figure class="card card-wide reveal" style="--sd: 0ms">
          <div class="apple-device apple-ipad-land">
            <div class="apple-screen apple-ipad-land-screen">
              <img src="/shots/pad-trackpad.jpg" width="1320" height="922" alt="iPad landscape VS Code stream with vertical PencilKit side rail and floating trackpad" loading="lazy" decoding="async" fetchpriority="low" />
            </div>
            <img class="apple-bezel" src="/bezels/ipad-pro-11-landscape.png" width="1050" height="748" alt="" aria-hidden="true" loading="lazy" decoding="async" fetchpriority="low" />
          </div>
          <figcaption>Side Rail &amp; Floating Trackpad (VS Code)</figcaption>
        </figure>
        <figure class="card reveal" style="--sd: 90ms">
          <div class="apple-device apple-ipad-port">
            <div class="apple-screen apple-ipad-port-screen">
              <img src="/shots/switcher.jpg" width="900" height="1288" alt="iPad Unified Switcher for Desktop, Mac windows, and installed apps" loading="lazy" decoding="async" fetchpriority="low" />
            </div>
            <img class="apple-bezel" src="/bezels/ipad-pro-11-portrait.png" width="641" height="900" alt="" aria-hidden="true" loading="lazy" decoding="async" fetchpriority="low" />
          </div>
          <figcaption>Unified Switcher</figcaption>
        </figure>
        <figure class="card reveal" style="--sd: 180ms">
          <div class="apple-device apple-ipad-port">
            <div class="apple-screen apple-ipad-port-screen">
              <img src="/shots/connect.jpg" width="900" height="1288" alt="iPad Connect screen discovering live Mac host over Wired connection" loading="lazy" decoding="async" fetchpriority="low" />
            </div>
            <img class="apple-bezel" src="/bezels/ipad-pro-11-portrait.png" width="641" height="900" alt="" aria-hidden="true" loading="lazy" decoding="async" fetchpriority="low" />
          </div>
          <figcaption>Connect</figcaption>
        </figure>
      </div>
    </section>

    <section class="chapter reveal" id="iphone">
      <div class="chapter-head">
        <span class="eyebrow">iPhone · Full-Screen Apps by Default</span>
        <h2>Full-screen Mac apps in your pocket.</h2>
        <p class="chapter-sub">
          Original Sill defaults iPhone portrait to a 16:10 pane above a fixed trackpad (with chrome-free Full Screen in Settings).
          Sill Tactile gives every Mac app the full iPhone screen by default, and shifts letterboxed apps upward so the space beneath acts naturally as a trackpad.
        </p>
      </div>
      <div class="grid-4">
        <figure class="card reveal" style="--sd: 0ms">
          <div class="apple-device apple-iphone-port">
            <div class="apple-screen apple-iphone-port-screen">
              <img src="/shots/phone-pill.jpg" width="620" height="1348" alt="iPhone full-screen Chrome window with compact Liquid Glass floating pill" loading="lazy" decoding="async" fetchpriority="low" />
            </div>
            <img class="apple-bezel" src="/bezels/iphone-17-portrait.png" width="421" height="860" alt="" aria-hidden="true" loading="lazy" decoding="async" fetchpriority="low" />
          </div>
          <figcaption>Full-Screen &amp; Pill</figcaption>
        </figure>
        <figure class="card reveal" style="--sd: 70ms">
          <div class="apple-device apple-iphone-port">
            <div class="apple-screen apple-iphone-port-screen">
              <img src="/shots/phone-orb.jpg" width="620" height="1348" alt="iPhone letterboxed Blender window shifted upward with natural bottom trackpad and 48pt corner orb" loading="lazy" decoding="async" fetchpriority="low" />
            </div>
            <img class="apple-bezel" src="/bezels/iphone-17-portrait.png" width="421" height="860" alt="" aria-hidden="true" loading="lazy" decoding="async" fetchpriority="low" />
          </div>
          <figcaption>Corner Orb &amp; Natural Pad</figcaption>
        </figure>
        <figure class="card reveal" style="--sd: 140ms">
          <div class="apple-device apple-iphone-port">
            <div class="apple-screen apple-iphone-port-screen">
              <img src="/shots/phone-deck.jpg" width="620" height="1348" alt="iPhone VS Code stream with iOS keyboard and tactile modifier keycap bar" loading="lazy" decoding="async" fetchpriority="low" />
            </div>
            <img class="apple-bezel" src="/bezels/iphone-17-portrait.png" width="421" height="860" alt="" aria-hidden="true" loading="lazy" decoding="async" fetchpriority="low" />
          </div>
          <figcaption>Keyboard &amp; Keycaps</figcaption>
        </figure>
        <figure class="card reveal" style="--sd: 210ms">
          <div class="apple-device apple-iphone-port">
            <div class="apple-screen apple-iphone-port-screen">
              <img src="/shots/phone-controls.jpg" width="620" height="1348" alt="iPhone Liquid Glass Control Center over live Mac Blender stream" loading="lazy" decoding="async" fetchpriority="low" />
            </div>
            <img class="apple-bezel" src="/bezels/iphone-17-portrait.png" width="421" height="860" alt="" aria-hidden="true" loading="lazy" decoding="async" fetchpriority="low" />
          </div>
          <figcaption>Control Center</figcaption>
        </figure>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footer-inner">
      <span>Fork of <a href={upstreamRepoUrl}>Saffsanity/sill</a> by Noah Saffer &middot; Apache-2.0 &middot; Tested only on Huy’s iPhone 17 &amp; iPad Pro</span>
      <div class="footer-links">
        <a href={testflightUrl}>TestFlight</a>
        <a href={forkRepoUrl}>Fork</a>
        <a href={originalSiteUrl}>Original Sill</a>
        <a href="/privacy/">Privacy</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const reveals = document.querySelectorAll<HTMLElement>(".reveal");
  if (!prefersReduced && "IntersectionObserver" in window) {
    reveals.forEach((el) => el.classList.add("will-reveal"));
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -32px 0px" },
    );
    reveals.forEach((el) => io.observe(el));
  }

  const heroVideo = document.getElementById("hero-video") as HTMLVideoElement | null;
  const videoToggle = document.getElementById("hero-video-toggle") as HTMLButtonElement | null;
  if (heroVideo && videoToggle) {
    let userPaused = prefersReduced;
    const syncLabel = () => {
      videoToggle.textContent = heroVideo.paused ? "Play" : "Pause";
    };
    if (prefersReduced) {
      heroVideo.pause();
      syncLabel();
    }
    videoToggle.addEventListener("click", () => {
      if (heroVideo.paused) {
        userPaused = false;
        heroVideo.play().catch(() => {});
      } else {
        userPaused = true;
        heroVideo.pause();
      }
      syncLabel();
    });
    heroVideo.addEventListener("play", syncLabel);
    heroVideo.addEventListener("pause", syncLabel);

    if ("IntersectionObserver" in window) {
      const videoIo = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              if (!userPaused) heroVideo.play().catch(() => {});
            } else if (!heroVideo.paused) {
              heroVideo.pause();
            }
          }
        },
        { threshold: 0.15 },
      );
      videoIo.observe(heroVideo);
    }
  }
</script>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background:
      radial-gradient(760px 460px at 72% 16%, rgba(10, 132, 255, 0.10), transparent 70%),
      radial-gradient(560px 380px at 18% 12%, rgba(255, 255, 255, 0.035), transparent 72%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .enter {
      opacity: 0;
      transform: translateY(18px);
      animation: enterUp 680ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--d, 0ms);
    }
    .reveal.will-reveal {
      opacity: 0;
      transform: translateY(24px) scale(0.985);
      transition: opacity 640ms cubic-bezier(0.22, 1, 0.36, 1), transform 640ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: var(--sd, 0ms);
    }
    .reveal.will-reveal.is-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  @keyframes enterUp {
    to { opacity: 1; transform: translateY(0); }
  }

  header {
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    background: rgba(0, 0, 0, 0.72);
    border-bottom: 1px solid var(--rim-soft);
  }
  .nav { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .brand img { border-radius: 7px; }
  .nav-links { display: flex; align-items: center; gap: 18px; font-size: 13.5px; }
  .nav-links a { color: var(--ink-2); transition: color 140ms ease; }
  .nav-links a:hover { color: var(--ink); text-decoration: none; }
  .nav-cta {
    padding: 6px 13px;
    border-radius: 999px;
    background: rgba(10, 132, 255, 0.16);
    border: 1px solid rgba(100, 210, 255, 0.3);
    color: var(--cyan) !important;
    font-weight: 600;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(380px, 1.15fr);
    gap: 48px;
    align-items: center;
    padding: 60px 0 72px;
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 36px; padding: 36px 0 56px; }
    .hero-stage { max-width: 640px; margin: 0 auto; width: 100%; }
  }
  .icon-pair { display: flex; gap: 14px; margin-bottom: 22px; }
  .app-icon {
    border-radius: 16px;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65), 0 0 0 1px var(--rim);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .app-icon:hover { transform: translateY(-3px) scale(1.03); }
  h1 {
    margin: 0 0 16px;
    font-size: clamp(38px, 5vw, 54px);
    font-weight: 700;
    letter-spacing: -0.038em;
    line-height: 1.03;
    background: linear-gradient(180deg, #ffffff 0%, #c8ccd6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede { margin: 0 0 24px; font-size: 17.5px; color: var(--ink-2); max-width: 440px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 22px; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 180ms ease;
  }
  .btn:hover { transform: translateY(-1.5px); text-decoration: none; }
  .btn-primary {
    background: var(--blue);
    color: #fff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 10px 28px rgba(10, 132, 255, 0.38);
  }
  .btn-secondary {
    background: var(--raised);
    color: var(--ink);
    border: 1px solid var(--rim);
  }
  .disclaimer { margin: 0; font-size: 13px; color: var(--ink-3); line-height: 1.65; }
  .disclaimer strong { color: var(--amber); font-weight: 600; }

  .hero-stage { position: relative; }
  .device-glow {
    position: absolute;
    inset: -14% -10%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(100, 210, 255, 0.14), rgba(10, 132, 255, 0.04) 55%, transparent 100%);
    pointer-events: none;
    z-index: 0;
  }

  .apple-device {
    position: relative;
    z-index: 1;
    width: 100%;
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .card:hover .apple-device {
    transform: translateY(-4px);
  }
  .apple-ipad-port { aspect-ratio: 1880 / 2640; }
  .apple-ipad-land { aspect-ratio: 2640 / 1880; }
  .apple-iphone-port { aspect-ratio: 1350 / 2760; }

  .apple-screen {
    position: absolute;
    overflow: hidden;
    background: #000;
    z-index: 1;
  }
  .apple-ipad-port-screen {
    left: 5.48%;
    top: 4.05%;
    width: 89.04%;
    height: 91.90%;
    border-radius: 3.4% / 2.4%;
  }
  .apple-ipad-land-screen {
    left: 4.05%;
    top: 5.48%;
    width: 91.90%;
    height: 89.04%;
    border-radius: 2.4% / 3.4%;
  }
  .apple-iphone-port-screen {
    left: 5.20%;
    top: 2.40%;
    width: 89.60%;
    height: 95.20%;
    border-radius: 13% / 6.2%;
  }
  .apple-screen > img,
  .apple-screen > video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .apple-bezel {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .stage-caption {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    font-size: 12.5px;
    color: var(--ink-3);
  }
  .video-toggle {
    appearance: none;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--rim);
    background: var(--raised);
    color: var(--ink-2);
    font: inherit;
    font-size: 11.5px;
    font-weight: 600;
    cursor: pointer;
    transition: color 140ms ease, border-color 140ms ease;
  }
  .video-toggle:hover {
    color: var(--ink);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .chapter { padding: 52px 0; }
  .chapter-head { margin-bottom: 28px; }
  .eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cyan);
    margin-bottom: 6px;
  }
  h2 {
    margin: 0;
    font-size: clamp(26px, 3.6vw, 36px);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .chapter-sub {
    margin: 10px 0 0;
    max-width: 660px;
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.55;
  }

  .grid-ipad {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    align-items: start;
  }
  .card-wide {
    grid-column: 1 / -1;
    max-width: 780px;
    margin: 0 auto;
    width: 100%;
  }
  .grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  @media (max-width: 840px) {
    .grid-ipad { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
    .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  }
  .card { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .card figcaption {
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
  }

  footer {
    margin-top: 40px;
    border-top: 1px solid var(--rim-soft);
    padding: 26px 0 44px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .footer-links { display: flex; gap: 18px; }
  .footer-links a { color: var(--ink-2); }
</style>
