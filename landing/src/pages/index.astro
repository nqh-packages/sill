---
import Layout from "../layouts/Layout.astro";

const testflightUrl = "https://testflight.apple.com/join/K8FpR5TR";
const forkRepoUrl = "https://github.com/nqh-packages/sill";
const upstreamRepoUrl = "https://github.com/Saffsanity/sill";
const originalSiteUrl = "https://getsill.app";
---
<Layout
  title="Sill Tactile — A different take on Sill for iOS & iPadOS"
  description="A tactile, Liquid Glass take on Noah Saffer's open-source Sill for iOS & iPadOS. Tested only on my iPhone 17 & iPad Pro."
  canonicalPath="/"
>
  <header>
    <div class="wrap nav">
      <a class="brand" href="/">
        <img src="/icon.png" alt="Sill Tactile icon" width="28" height="28" />
        <span>Sill Tactile</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href={testflightUrl}>TestFlight</a>
        <a href={forkRepoUrl}>GitHub</a>
        <a href={upstreamRepoUrl}>Original by Noah Saffer</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <!-- Hero: Show the PencilKit drag-to-orb & 4-edge morph live above the fold -->
    <section class="hero">
      <div class="hero-copy">
        <div class="icon-pair">
          <img class="app-icon" src="/icon.png" alt="Sill Tactile dark Liquid Glass icon" width="76" height="76" />
          <img class="app-icon" src="/icon-light.png" alt="Sill Tactile light Liquid Glass icon" width="76" height="76" />
        </div>
        <h1>Sill, reimagined for touch.</h1>
        <p class="lede">
          A different take on <a href={upstreamRepoUrl}>Noah Saffer’s Sill</a> for iOS &amp; iPadOS.
          Same <a href={`${originalSiteUrl}/download.html`}>Sill for Mac</a> &amp; encrypted protocol.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={testflightUrl}>Join TestFlight</a>
          <a class="btn btn-secondary" href={forkRepoUrl}>GitHub</a>
        </div>
        <p class="disclaimer">
          All credit to <a href="https://github.com/Saffsanity">Noah Saffer</a> (<a href={upstreamRepoUrl}>Saffsanity/sill</a>).<br />
          <strong>Tested only on my own iPhone 17 &amp; iPad Pro</strong> — for the official app, use <a href={originalSiteUrl}>getsill.app</a>.
        </p>
      </div>

      <div class="hero-stage">
        <figure class="device-bezel ipad-stage">
          <video
            src="/media/pencilkit-chrome.mp4"
            poster="/media/pencilkit-poster.jpg"
            autoplay
            muted
            loop
            playsinline
            aria-label="Sill Tactile PencilKit floating bar collapsing into a 48pt orb on drag and docking across all four edges and corners"
          ></video>
        </figure>
        <div class="stage-caption">Drag to minimize · 4-edge dock · 4-corner orb</div>
      </div>
    </section>

    <!-- iPad Screens -->
    <section class="gallery">
      <div class="section-label">iPad</div>
      <div class="grid-3">
        <figure class="frame">
          <img src="/shots/pad-trackpad.png" alt="iPad vertical PencilKit rail with floating trackpad" loading="lazy" />
          <figcaption>Side Rail &amp; Floating Trackpad</figcaption>
        </figure>
        <figure class="frame">
          <img src="/shots/switcher.png" alt="iPad Unified Switcher for Desktop, windows, and Mac apps" loading="lazy" />
          <figcaption>Unified Switcher</figcaption>
        </figure>
        <figure class="frame">
          <img src="/shots/connect.png" alt="iPad Connect screen with semantic route LEDs" loading="lazy" />
          <figcaption>Connect</figcaption>
        </figure>
      </div>
    </section>

    <!-- iPhone Screens -->
    <section class="gallery">
      <div class="section-label">iPhone</div>
      <div class="grid-4">
        <figure class="frame phone-frame">
          <img src="/shots/phone-pill.png" alt="iPhone compact Liquid Glass floating pill" loading="lazy" />
          <figcaption>Compact Pill</figcaption>
        </figure>
        <figure class="frame phone-frame">
          <img src="/shots/phone-orb.png" alt="iPhone minimized 48pt corner orb" loading="lazy" />
          <figcaption>Corner Orb</figcaption>
        </figure>
        <figure class="frame phone-frame">
          <img src="/shots/phone-deck.png" alt="iPhone bottom-anchored tactile Control Deck" loading="lazy" />
          <figcaption>Control Deck</figcaption>
        </figure>
        <figure class="frame phone-frame">
          <img src="/shots/phone-controls.png" alt="iPhone Control Center with Liquid Glass header" loading="lazy" />
          <figcaption>Control Center</figcaption>
        </figure>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footer-inner">
      <span>Fork of <a href={upstreamRepoUrl}>Saffsanity/sill</a> by Noah Saffer &middot; Apache-2.0 &middot; Tested only on Huy’s devices</span>
      <div class="footer-links">
        <a href={testflightUrl}>TestFlight</a>
        <a href={forkRepoUrl}>Fork</a>
        <a href={originalSiteUrl}>Original Sill</a>
        <a href="/privacy/">Privacy</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    background: rgba(0, 0, 0, 0.72);
    border-bottom: 1px solid var(--rim-soft);
  }
  .nav { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .brand img { border-radius: 7px; }
  .nav-links { display: flex; align-items: center; gap: 20px; font-size: 13.5px; }
  .nav-links a { color: var(--ink-2); }
  .nav-links a:hover { color: var(--ink); text-decoration: none; }

  /* Split visual hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
    gap: 48px;
    align-items: center;
    padding: 56px 0 64px;
  }
  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; gap: 36px; padding: 36px 0 48px; }
    .hero-stage { max-width: 360px; margin: 0 auto; width: 100%; }
  }
  .icon-pair { display: flex; gap: 14px; margin-bottom: 24px; }
  .app-icon {
    border-radius: 18px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6), 0 0 0 1px var(--rim);
  }
  h1 {
    margin: 0 0 14px;
    font-size: clamp(38px, 5.5vw, 54px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  .lede {
    margin: 0 0 26px;
    font-size: 18px;
    color: var(--ink-2);
    max-width: 480px;
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    transition: transform 0.15s ease;
  }
  .btn:hover { transform: translateY(-1px); text-decoration: none; }
  .btn-primary {
    background: var(--blue);
    color: #fff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 8px 24px rgba(10, 132, 255, 0.35);
  }
  .btn-secondary {
    background: var(--raised);
    color: var(--ink);
    border: 1px solid var(--rim);
  }
  .disclaimer {
    margin: 0;
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1.6;
  }
  .disclaimer strong { color: var(--amber); font-weight: 600; }

  /* Hero looping iPad video */
  .device-bezel {
    margin: 0;
    padding: 10px;
    border-radius: 28px;
    background: var(--surface);
    border: 1px solid var(--rim);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
  }
  .device-bezel video {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 20px;
    background: #000;
  }
  .stage-caption {
    margin-top: 12px;
    text-align: center;
    font-size: 12.5px;
    color: var(--ink-3);
    letter-spacing: 0.01em;
  }

  /* Galleries */
  .gallery { padding: 20px 0 40px; }
  .section-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    margin-bottom: 14px;
  }
  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .grid-4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 820px) {
    .grid-3 { grid-template-columns: 1fr; }
    .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .frame {
    margin: 0;
    padding: 8px;
    border-radius: 22px;
    background: var(--surface);
    border: 1px solid var(--rim-soft);
    display: flex;
    flex-direction: column;
  }
  .frame img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 15px;
    background: #000;
  }
  .phone-frame img { border-radius: 20px; }
  .frame figcaption {
    padding: 10px 6px 4px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink-2);
    text-align: center;
  }

  footer {
    margin-top: 24px;
    border-top: 1px solid var(--rim-soft);
    padding: 24px 0 40px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .footer-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .footer-links { display: flex; gap: 18px; }
  .footer-links a { color: var(--ink-2); }
</style>
