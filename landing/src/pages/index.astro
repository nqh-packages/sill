---
import Layout from "../layouts/Layout.astro";

const testflightUrl = "https://testflight.apple.com/join/K8FpR5TR";
const forkRepoUrl = "https://github.com/nqh-packages/sill";
const upstreamRepoUrl = "https://github.com/Saffsanity/sill";
const originalSiteUrl = "https://getsill.app";
---
<Layout
  title="Sill Tactile — A different take on Sill for iOS & iPadOS"
  description="A tactile, Liquid Glass take on Noah Saffer's open-source Sill for iOS & iPadOS. Tested only on my iPhone 17 & iPad Pro."
  canonicalPath="/"
>
  <div class="ambient-bg" aria-hidden="true"></div>

  <header>
    <div class="wrap nav">
      <a class="brand" href="/">
        <img src="/icon.png" alt="Sill Tactile icon" width="28" height="28" />
        <span>Sill Tactile</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="#playground">Try Chrome</a>
        <a href="#ipad">iPad</a>
        <a href="#iphone">iPhone</a>
        <a href={forkRepoUrl}>GitHub</a>
        <a class="nav-cta" href={testflightUrl}>TestFlight</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <!-- Hero: Live looping iPad Pro hardware frame with zero empty screens -->
    <section class="hero">
      <div class="hero-copy">
        <div class="icon-pair enter" style="--d: 0ms">
          <img class="app-icon" src="/icon.png" alt="Sill Tactile dark Liquid Glass icon" width="72" height="72" />
          <img class="app-icon" src="/icon-light.png" alt="Sill Tactile light Liquid Glass icon" width="72" height="72" />
        </div>
        <h1 class="enter" style="--d: 70ms">Sill, reimagined<br />for touch.</h1>
        <p class="lede enter" style="--d: 140ms">
          A different take on <a href={upstreamRepoUrl}>Noah Saffer’s Sill</a> for iOS &amp; iPadOS.
          Same <a href={`${originalSiteUrl}/download.html`}>Sill for Mac</a> &amp; encrypted protocol.
        </p>
        <div class="cta-row enter" style="--d: 210ms">
          <a class="btn btn-primary" href={testflightUrl}>Join TestFlight Beta</a>
          <a class="btn btn-secondary" href={forkRepoUrl}>View on GitHub</a>
        </div>
        <p class="disclaimer enter" style="--d: 280ms">
          All credit to <a href="https://github.com/Saffsanity">Noah Saffer</a> (<a href={upstreamRepoUrl}>Saffsanity/sill</a>).<br />
          <strong>Only tested on my own iPhone 17 &amp; iPad Pro</strong> — for the official app, use <a href={originalSiteUrl}>getsill.app</a>.
        </p>
      </div>

      <div class="hero-stage enter" style="--d: 140ms">
        <div class="stage-frame stage-hero">
          <img class="stage-photo" src="/backdrops/hero-radial-blue.jpg" alt="" aria-hidden="true" draggable="false" />
          <div class="stage-scrim" aria-hidden="true"></div>
          <div class="apple-device apple-ipad-port hero-ipad">
            <div class="apple-screen apple-ipad-port-screen">
              <video
                src="/media/pencilkit-chrome.mp4"
                poster="/media/pencilkit-poster.jpg"
                autoplay
                muted
                loop
                playsinline
                aria-label="Sill Tactile PencilKit floating bar collapsing into a 48pt orb on drag and docking across all four edges and corners over a Mac Swift window"
              ></video>
            </div>
            <img class="apple-bezel" src="/bezels/ipad-pro-11-portrait.png" alt="" aria-hidden="true" draggable="false" />
          </div>
        </div>
        <div class="stage-caption">Real simulator capture · Drag to orb · 4-edge dock · 4-corner minimize</div>
      </div>
    </section>

    <section class="chapter reveal" id="playground">
      <div class="chapter-head">
        <span class="eyebrow">Interactive Demo</span>
        <h2>Grab the bar. Flick it anywhere.</h2>
      </div>
      <div class="playground-shell">
        <div class="stage-frame stage-playground">
          <img class="stage-photo" src="/backdrops/playground-sonoma.jpg" alt="" aria-hidden="true" draggable="false" />
          <div class="stage-scrim" aria-hidden="true"></div>
          <div class="apple-device apple-ipad-land">
            <div class="apple-screen apple-ipad-land-screen playground-screen" id="pk-stage">
              <img class="stage-bg" id="pk-bg" src="/media/pencilkit-poster.jpg" alt="" draggable="false" />
              <div class="stage-mask" id="pk-mask" aria-hidden="true"></div>
              <div class="pk-ghost" id="pk-ghost" aria-hidden="true"></div>
              <button
                type="button"
                class="pk-pill"
                id="pk-pill"
                data-edge="bottom"
                data-minimized="false"
                aria-label="Draggable Sill floating bar — drag to any edge or corner"
              >
                <span class="pk-orb-badge" aria-hidden="true">Co</span>
                <span class="pk-expanded" aria-hidden="true">
                  <span class="pk-grip"></span>
                  <span class="pk-app fi">Fi</span>
                  <span class="pk-app co active">Co</span>
                  <span class="pk-app no">No</span>
                  <span class="pk-div"></span>
                  <span class="pk-dot"></span>
                  <span class="pk-dot"></span>
                  <span class="pk-dot"></span>
                  <span class="pk-dot"></span>
                </span>
              </button>
              <div class="pk-scenes" role="group" aria-label="Demo backdrop">
                <button type="button" class="pk-scene active" data-src="/media/pencilkit-poster.jpg" data-mask="true">Code</button>
                <button type="button" class="pk-scene" data-src="/backdrops/playground-sonoma.jpg" data-mask="false">Sonoma</button>
                <button type="button" class="pk-scene" data-src="/backdrops/hero-radial-blue.jpg" data-mask="false">Radial</button>
                <button type="button" class="pk-scene" data-src="/backdrops/mac-purple.jpg" data-mask="false">Mac</button>
              </div>
              <div class="pk-hint" id="pk-hint">Drag the bar to any edge or corner</div>
            </div>
            <img class="apple-bezel" src="/bezels/ipad-pro-11-landscape.png" alt="" aria-hidden="true" draggable="false" />
          </div>
        </div>
      </div>
    </section>

    <section class="chapter reveal" id="ipad">
      <div class="chapter-head">
        <span class="eyebrow">iPad</span>
        <h2>Full canvas. Zero clutter.</h2>
      </div>
      <div class="grid-3">
        <figure class="card reveal" style="--sd: 0ms">
          <div class="stage-frame stage-card">
            <img class="stage-photo" src="/backdrops/mac-blue.jpg" alt="" aria-hidden="true" loading="lazy" />
            <div class="stage-scrim" aria-hidden="true"></div>
            <div class="apple-device apple-ipad-port">
              <div class="apple-screen apple-ipad-port-screen">
                <img src="/shots/pad-trackpad.png" alt="iPad vertical PencilKit rail with floating trackpad over a Mac Swift window" loading="lazy" />
              </div>
              <img class="apple-bezel" src="/bezels/ipad-pro-11-portrait.png" alt="" aria-hidden="true" loading="lazy" />
            </div>
          </div>
          <figcaption>Side Rail &amp; Floating Trackpad</figcaption>
        </figure>
        <figure class="card reveal" style="--sd: 90ms">
          <div class="stage-frame stage-card">
            <img class="stage-photo" src="/backdrops/mac-purple.jpg" alt="" aria-hidden="true" loading="lazy" />
            <div class="stage-scrim" aria-hidden="true"></div>
            <div class="apple-device apple-ipad-port">
              <div class="apple-screen apple-ipad-port-screen">
                <img src="/shots/switcher.png" alt="iPad Unified Switcher for Desktop, Mac windows, and installed apps" loading="lazy" />
              </div>
              <img class="apple-bezel" src="/bezels/ipad-pro-11-portrait.png" alt="" aria-hidden="true" loading="lazy" />
            </div>
          </div>
          <figcaption>Unified Switcher</figcaption>
        </figure>
        <figure class="card reveal" style="--sd: 180ms">
          <div class="stage-frame stage-card">
            <img class="stage-photo" src="/backdrops/imac-green.jpg" alt="" aria-hidden="true" loading="lazy" />
            <div class="stage-scrim" aria-hidden="true"></div>
            <div class="apple-device apple-ipad-port">
              <div class="apple-screen apple-ipad-port-screen">
                <img src="/shots/connect.png" alt="iPad Connect screen with machined display bezels and route LEDs" loading="lazy" />
              </div>
              <img class="apple-bezel" src="/bezels/ipad-pro-11-portrait.png" alt="" aria-hidden="true" loading="lazy" />
            </div>
          </div>
          <figcaption>Connect</figcaption>
        </figure>
      </div>
    </section>

    <section class="chapter reveal" id="iphone">
      <div class="chapter-head">
        <span class="eyebrow">iPhone · Full-Screen Apps by Default</span>
        <h2>Full-screen Mac apps in your pocket.</h2>
        <p class="chapter-sub">
          Original Sill defaults iPhone portrait to a 16:10 pane above a fixed trackpad (with chrome-free Full Screen in Settings).
          Sill Tactile gives every Mac app the full iPhone screen by default, with a floating Liquid Glass pill or 48pt corner orb.
        </p>
      </div>
      <div class="grid-4">
        <figure class="card reveal" style="--sd: 0ms">
          <div class="stage-frame stage-card stage-phone">
            <img class="stage-photo" src="/backdrops/imac-blue.jpg" alt="" aria-hidden="true" loading="lazy" />
            <div class="stage-scrim" aria-hidden="true"></div>
            <div class="apple-device apple-iphone-port">
              <div class="apple-screen apple-iphone-port-screen">
                <img src="/shots/phone-pill.png" alt="iPhone compact Liquid Glass floating pill over a full-screen Mac Swift window" loading="lazy" />
              </div>
              <img class="apple-bezel" src="/bezels/iphone-17-portrait.png" alt="" aria-hidden="true" loading="lazy" />
            </div>
          </div>
          <figcaption>Full-Screen &amp; Pill</figcaption>
        </figure>
        <figure class="card reveal" style="--sd: 70ms">
          <div class="stage-frame stage-card stage-phone">
            <img class="stage-photo" src="/backdrops/imac-orange.jpg" alt="" aria-hidden="true" loading="lazy" />
            <div class="stage-scrim" aria-hidden="true"></div>
            <div class="apple-device apple-iphone-port">
              <div class="apple-screen apple-iphone-port-screen">
                <img src="/shots/phone-orb.png" alt="iPhone minimized 48pt corner orb over a full-bleed Mac window" loading="lazy" />
              </div>
              <img class="apple-bezel" src="/bezels/iphone-17-portrait.png" alt="" aria-hidden="true" loading="lazy" />
            </div>
          </div>
          <figcaption>Corner Orb</figcaption>
        </figure>
        <figure class="card reveal" style="--sd: 140ms">
          <div class="stage-frame stage-card stage-phone">
            <img class="stage-photo" src="/backdrops/imac-purple.jpg" alt="" aria-hidden="true" loading="lazy" />
            <div class="stage-scrim" aria-hidden="true"></div>
            <div class="apple-device apple-iphone-port">
              <div class="apple-screen apple-iphone-port-screen">
                <img src="/shots/phone-deck.png" alt="iPhone bottom-anchored tactile Control Deck over a Mac window" loading="lazy" />
              </div>
              <img class="apple-bezel" src="/bezels/iphone-17-portrait.png" alt="" aria-hidden="true" loading="lazy" />
            </div>
          </div>
          <figcaption>Control Deck</figcaption>
        </figure>
        <figure class="card reveal" style="--sd: 210ms">
          <div class="stage-frame stage-card stage-phone">
            <img class="stage-photo" src="/backdrops/imac-silver.jpg" alt="" aria-hidden="true" loading="lazy" />
            <div class="stage-scrim" aria-hidden="true"></div>
            <div class="apple-device apple-iphone-port">
              <div class="apple-screen apple-iphone-port-screen">
                <img src="/shots/phone-controls.png" alt="iPhone Control Center with native Liquid Glass header" loading="lazy" />
              </div>
              <img class="apple-bezel" src="/bezels/iphone-17-portrait.png" alt="" aria-hidden="true" loading="lazy" />
            </div>
          </div>
          <figcaption>Control Center</figcaption>
        </figure>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap footer-inner">
      <span>Fork of <a href={upstreamRepoUrl}>Saffsanity/sill</a> by Noah Saffer &middot; Apache-2.0 &middot; Tested only on Huy’s iPhone 17 &amp; iPad Pro</span>
      <div class="footer-links">
        <a href={testflightUrl}>TestFlight</a>
        <a href={forkRepoUrl}>Fork</a>
        <a href={originalSiteUrl}>Original Sill</a>
        <a href="/privacy/">Privacy</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Scroll-triggered Apple-style spring reveals
  const reveals = document.querySelectorAll<HTMLElement>(".reveal");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
    );
    reveals.forEach((el) => io.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add("is-visible"));
  }

  // Interactive PencilKit-style floating bar demo
  const stage = document.getElementById("pk-stage");
  const pill = document.getElementById("pk-pill");
  const ghost = document.getElementById("pk-ghost");
  const hint = document.getElementById("pk-hint");

  if (stage && pill && ghost) {
    type Dock =
      | { kind: "edge"; edge: "top" | "bottom" | "leading" | "trailing" }
      | { kind: "corner"; corner: "tl" | "tr" | "bl" | "br"; returnEdge: "top" | "bottom" | "leading" | "trailing" };

    let dock: Dock = { kind: "edge", edge: "bottom" };
    let dragging = false;
    let moved = false;
    let startX = 0;
    let startY = 0;

    const restPos = (d: Dock, w: number, h: number) => {
      const m = 22;
      const half = 22;
      if (d.kind === "edge") {
        if (d.edge === "top") return { x: w / 2, y: m + half };
        if (d.edge === "bottom") return { x: w / 2, y: h - m - half };
        if (d.edge === "leading") return { x: m + half, y: h / 2 };
        return { x: w - m - half, y: h / 2 };
      }
      const x = d.corner === "tl" || d.corner === "bl" ? m + half : w - m - half;
      const y = d.corner === "tl" || d.corner === "tr" ? m + half : h - m - half;
      return { x, y };
    };

    const snapFor = (nx: number, ny: number, prevEdge: "top" | "bottom" | "leading" | "trailing"): Dock => {
      const x = Math.max(0, Math.min(1, nx));
      const y = Math.max(0, Math.min(1, ny));
      const cX = 0.22;
      const cY = 0.24;
      if (x <= cX && y <= cY) return { kind: "corner", corner: "tl", returnEdge: prevEdge === "leading" ? "leading" : "top" };
      if (x >= 1 - cX && y <= cY) return { kind: "corner", corner: "tr", returnEdge: prevEdge === "trailing" ? "trailing" : "top" };
      if (x <= cX && y >= 1 - cY) return { kind: "corner", corner: "bl", returnEdge: prevEdge === "leading" ? "leading" : "bottom" };
      if (x >= 1 - cX && y >= 1 - cY) return { kind: "corner", corner: "br", returnEdge: prevEdge === "trailing" ? "trailing" : "bottom" };
      const dists: Array<["top" | "bottom" | "leading" | "trailing", number]> = [
        ["bottom", 1 - y],
        ["top", y],
        ["trailing", 1 - x],
        ["leading", x],
      ];
      dists.sort((a, b) => a[1] - b[1]);
      return { kind: "edge", edge: dists[0][0] };
    };

    const applyDock = (animate = true) => {
      const r = stage.getBoundingClientRect();
      const pos = restPos(dock, r.width, r.height);
      pill.style.transition = animate
        ? "left 340ms cubic-bezier(0.22, 1, 0.36, 1), top 340ms cubic-bezier(0.22, 1, 0.36, 1), width 340ms cubic-bezier(0.22, 1, 0.36, 1), height 340ms cubic-bezier(0.22, 1, 0.36, 1), transform 180ms ease"
        : "none";
      pill.style.left = `${pos.x}px`;
      pill.style.top = `${pos.y}px`;
      pill.dataset.minimized = dock.kind === "corner" ? "true" : "false";
      pill.dataset.edge = dock.kind === "edge" ? dock.edge : dock.returnEdge;
      pill.classList.remove("is-dragging");
      ghost.classList.remove("visible");
    };

    const showGhost = (target: Dock) => {
      const r = stage.getBoundingClientRect();
      const pos = restPos(target, r.width, r.height);
      ghost.style.left = `${pos.x}px`;
      ghost.style.top = `${pos.y}px`;
      ghost.dataset.shape = target.kind === "corner" ? "orb" : target.edge === "leading" || target.edge === "trailing" ? "vert" : "horiz";
      ghost.classList.add("visible");
    };

    applyDock(false);
    window.addEventListener("resize", () => applyDock(false));

    pill.addEventListener("pointerdown", (e) => {
      dragging = true;
      moved = false;
      startX = e.clientX;
      startY = e.clientY;
      pill.setPointerCapture(e.pointerId);
      if (hint) hint.classList.add("hidden");
    });

    pill.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dist = Math.hypot(e.clientX - startX, e.clientY - startY);
      if (!moved && dist < 8) return;
      moved = true;
      const r = stage.getBoundingClientRect();
      const x = Math.max(32, Math.min(r.width - 32, e.clientX - r.left));
      const y = Math.max(32, Math.min(r.height - 32, e.clientY - r.top));
      pill.classList.add("is-dragging");
      pill.dataset.minimized = "true";
      pill.style.transition = "width 180ms cubic-bezier(0.22, 1, 0.36, 1), height 180ms cubic-bezier(0.22, 1, 0.36, 1), transform 160ms ease";
      pill.style.left = `${x}px`;
      pill.style.top = `${y}px`;
      const prevEdge = dock.kind === "edge" ? dock.edge : dock.returnEdge;
      showGhost(snapFor(x / r.width, y / r.height, prevEdge));
    });

    const finishDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      if (moved) {
        const r = stage.getBoundingClientRect();
        const prevEdge = dock.kind === "edge" ? dock.edge : dock.returnEdge;
        dock = snapFor((e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height, prevEdge);
        applyDock(true);
      } else if (dock.kind === "corner") {
        dock = { kind: "edge", edge: dock.returnEdge };
        applyDock(true);
      }
    };

    pill.addEventListener("pointerup", finishDrag);
    pill.addEventListener("pointercancel", finishDrag);

    const bgImg = document.getElementById("pk-bg") as HTMLImageElement | null;
    const bgMask = document.getElementById("pk-mask");
    const sceneBtns = document.querySelectorAll<HTMLButtonElement>(".pk-scene");
    sceneBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.dataset.src;
        if (bgImg && src) bgImg.src = src;
        if (bgMask) bgMask.style.opacity = btn.dataset.mask === "true" ? "1" : "0";
        sceneBtns.forEach((b) => b.classList.toggle("active", b === btn));
      });
    });
  }
</script>

<style>
  .ambient-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background:
      radial-gradient(900px 560px at 76% 14%, rgba(10, 132, 255, 0.16), transparent 68%),
      radial-gradient(640px 420px at 18% 12%, rgba(100, 210, 255, 0.08), transparent 72%);
  }
  .ambient-bg::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 78vh;
    background: url("/backdrops/hero-radial-blue.jpg") center / cover no-repeat;
    opacity: 0.24;
    filter: blur(28px) saturate(135%);
    transform: scale(1.08);
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.4) 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.4) 55%, transparent 100%);
  }

  /* Entrance & scroll reveals */
  .enter {
    opacity: 0;
    transform: translateY(18px);
    animation: enterUp 680ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes enterUp {
    to { opacity: 1; transform: translateY(0); }
  }
  .reveal {
    opacity: 0;
    transform: translateY(24px) scale(0.985);
    transition: opacity 640ms cubic-bezier(0.22, 1, 0.36, 1), transform 640ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--sd, 0ms);
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .enter, .reveal, .stage-photo { animation: none; transition: none; opacity: 1; transform: none; }
  }

  /* Header */
  header {
    position: sticky;
    top: 0;
    z-index: 30;
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    background: rgba(0, 0, 0, 0.7);
    border-bottom: 1px solid var(--rim-soft);
  }
  .nav { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 600; font-size: 15px; letter-spacing: -0.01em; }
  .brand img { border-radius: 7px; }
  .nav-links { display: flex; align-items: center; gap: 18px; font-size: 13.5px; }
  .nav-links a { color: var(--ink-2); transition: color 140ms ease; }
  .nav-links a:hover { color: var(--ink); text-decoration: none; }
  .nav-cta {
    padding: 6px 13px;
    border-radius: 999px;
    background: rgba(10, 132, 255, 0.16);
    border: 1px solid rgba(100, 210, 255, 0.3);
    color: var(--cyan) !important;
    font-weight: 600;
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 440px);
    gap: 52px;
    align-items: center;
    padding: 56px 0 72px;
  }
  @media (max-width: 840px) {
    .hero { grid-template-columns: 1fr; gap: 36px; padding: 36px 0 56px; }
    .hero-stage { max-width: 360px; margin: 0 auto; width: 100%; }
  }
  .icon-pair { display: flex; gap: 14px; margin-bottom: 24px; }
  .app-icon {
    border-radius: 17px;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65), 0 0 0 1px var(--rim);
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .app-icon:hover { transform: translateY(-3px) scale(1.03); }
  h1 {
    margin: 0 0 16px;
    font-size: clamp(40px, 5.8vw, 58px);
    font-weight: 700;
    letter-spacing: -0.038em;
    line-height: 1.03;
    background: linear-gradient(180deg, #ffffff 0%, #c8ccd6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede { margin: 0 0 26px; font-size: 18px; color: var(--ink-2); max-width: 470px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border-radius: 999px;
    font-size: 15px;
